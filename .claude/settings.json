{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/sync_development.py\" --hook session-start --repo \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/sync_development.py\" --hook pre-tool-use --no-fetch --repo \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
